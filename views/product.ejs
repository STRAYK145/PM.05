<%- include('partials/header', { title: product.name }) %>

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/catalog">Каталог</a></li>
            <li class="breadcrumb-item active" aria-current="page"><%= product.name %></li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Фото -->
        <div class="col-12 col-md-6">
            <div class="card shadow-sm">
                <img src="/images/<%= product.image %>" class="card-img-top p-3"
                     alt="<%= product.name %>"
                     style="max-height: 450px; object-fit: contain;">
            </div>
        </div>

        <!-- Информация -->
        <div class="col-12 col-md-6">
            <h1 class="h3 mb-3"><%= product.name %></h1>

            <p class="display-6 fw-bold mb-4">
                <%= Number(product.price).toLocaleString('ru-RU') %> ₽
            </p>

            <h2 class="h5">Характеристики</h2>
            <table class="table table-sm mb-4">
                <tbody>
                    <tr>
                        <th scope="row" class="w-50 fw-normal text-muted">Страна-производитель</th>
                        <td><%= product.country %></td>
                    </tr>
                    <tr>
                        <th scope="row" class="fw-normal text-muted">Год выпуска</th>
                        <td><%= product.year %></td>
                    </tr>
                    <tr>
                        <th scope="row" class="fw-normal text-muted">Модель</th>
                        <td><%= product.model %></td>
                    </tr>
                </tbody>
            </table>

            <form action="/cart/add" method="POST">
                <input type="hidden" name="product_id" value="<%= product.id %>">
                <button type="submit" class="btn btn-primary btn-lg">В корзину</button>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer') %>